[Unit]
Description=Arcade Arena game server (TikTok events -> stage)
After=network-online.target
Wants=network-online.target

[Service]
User=arena
WorkingDirectory=/opt/arena/arcade
EnvironmentFile=/etc/arena/arena.env
Environment=XDG_RUNTIME_DIR=/run/user/1500
ExecStart=/usr/bin/node server.js --record
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
