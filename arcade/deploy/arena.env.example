# Copy to /etc/arena/arena.env. Read by the game server service.
PORT=3000
# your TikTok username (no @): the server connects when you go live and keeps retrying
TIKTOK_USERNAME=REPLACE-WITH-YOUR-USERNAME
# protects /director and stage controls; open /director?key=THIS on your phone
DIRECTOR_KEY=REPLACE-WITH-A-LONG-RANDOM-STRING
# lets the director's "Go live" panel start/stop the stream on this VM
BROADCAST=1
# --- optional TikTok chat bot (off unless all three are set AND the director
# toggle "TikTok chat bot" is on). Use a SECONDARY TikTok account: its session
# cookie is forwarded to the Euler Stream sign server to post messages, and
# sending needs a paid Euler plan. See GOOGLE_CLOUD.md "Auto messages".
# SIGN_API_KEY=
# CHATBOT_SESSIONID=
# CHATBOT_TT_TARGET_IDC=
