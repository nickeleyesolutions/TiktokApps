# Copy to /etc/arena/stream.env and `chmod 600` it. Never commit the real file.
# Both values come from TikTok: LIVE Studio / "Go LIVE" on desktop web shows a
# Server URL and a Stream key once your account can stream with a key.
RTMP_URL=rtmp://REPLACE-WITH-SERVER-URL/
STREAM_KEY=REPLACE-WITH-STREAM-KEY
# 1080x1920 at 30 fps, ~6 Mbps. On a small VM or weak link use 720/1280 and 3200k.
RES_W=1080
RES_H=1920
FPS=30
VBITRATE=6000k
